# Required for durable game sessions on Vercel (server-side only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel integrations using KV_REST_API_URL / KV_REST_API_TOKEN are also supported.
# No Redis credentials are needed for local development: SQLite is used locally.

# Optional licensed historical squad import. Demo gameplay needs no provider token.
SPORTMONKS_API_TOKEN=
MIN_APPEARANCES=3
MIN_MINUTES=150
FEATURED_PLAYER_IDS=
